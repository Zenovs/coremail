{
  "name": "coremail-desktop",
  "version": "7.3.0",
  "description": "CoreMail Desktop - Lightweight IMAP/SMTP email client for Linux with Microsoft 365 OAuth2 and dark themes",
  "author": "Dario Zenhäusern",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zenovs/coremail.git"
  },
  "keywords": [
    "email",
    "email-client",
    "mail",
    "imap",
    "smtp",
    "electron",
    "linux",
    "microsoft-365",
    "outlook",
    "graph-api",
    "oauth2",
    "dark-theme",
    "raspberry-pi",
    "appimage",
    "desktop-app"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && node scripts/dev-electron.js\"",
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "build": "npm run react-build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.coremail.desktop",
    "productName": "CoreMail Desktop",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extends": null,
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network;Email",
      "synopsis": "Minimaler E-Mail-Client für Linux",
      "description": "CoreMail Desktop - Ein schlanker IMAP/SMTP E-Mail-Client mit dunklem Design",
      "maintainer": "CoreMail Team"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "CoreMail Desktop ${version}"
    },
    "appImage": {
      "artifactName": "CoreMail-Desktop-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "CoreMail-Desktop-${version}-${arch}.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    },
    "rpm": {
      "artifactName": "CoreMail-Desktop-${version}-${arch}.rpm"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "lib/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,readme.md,readme,test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/coremail-icon-256.png",
        "to": "icons/256x256.png"
      },
      {
        "from": "assets/coremail-icon-128.png",
        "to": "icons/128x128.png"
      },
      {
        "from": "assets/coremail-icon-64.png",
        "to": "icons/64x64.png"
      },
      {
        "from": "assets/coremail-icon-32.png",
        "to": "icons/32x32.png"
      }
    ]
  },
  "homepage": "./",
  "dependencies": {
    "@azure/msal-node": "^3.8.9",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.1.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.12",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.9"
  },
  "devDependencies": {
    "@carbon/icons-react": "^11.69.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "dompurify": "^3.4.11",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.1",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "glob": "^10.4.5",
    "tar": "^6.2.1",
    "rimraf": "^5.0.10"
  }
}
